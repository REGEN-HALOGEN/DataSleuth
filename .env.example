# Development configuration template. Copy to .env and supply unique secrets.
# Do not use these settings for a network-exposed deployment.
POSTGRES_PASSWORD=replace_with_unique_random_secret
DATABASE_URL=postgresql+psycopg://datasleuth:replace_with_unique_random_secret@127.0.0.1:5432/datasleuth
REDIS_PASSWORD=replace_with_another_unique_random_secret
REDIS_URL=redis://:replace_with_another_unique_random_secret@127.0.0.1:6379/0
APPLICATION_SECRET=replace_with_unique_random_secret
HMAC_KEY=replace_with_unique_random_secret
HMAC_KEY_VERSION=1
# Explicitly configure approved roots before enabling scanning.
ALLOWED_SCAN_ROOTS=[]
MAX_FILE_SIZE_BYTES=10485760
MAX_SCAN_DEPTH=10
MAX_FILES_PER_SCAN=10000
MAX_PROCESSING_SECONDS_PER_FILE=30
LOG_LEVEL=INFO
BROWSER_ORIGIN=http://127.0.0.1:5173
