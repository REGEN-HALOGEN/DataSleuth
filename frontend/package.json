    "@types/react": "19.1.6",
    "@types/react-dom": "19.1.6",
    "@vitejs/plugin-react": "4.5.1",
    "eslint": "10.15.0",
    "prettier": "3.10.1",
    "typescript": "5.8.3",
    "typescript-eslint": "8.73.0",
    "vite": "6.4.6"
